<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head'); %>
</head>

<body data-sidebar="dark">
  <!-- [ navigation menu ] start -->
  <%- include('../partials/header'); %>
    <!-- [ navigation menu ] end -->
    <%- include('../partials/sidebar'); %>
      <div class="home-btn d-none d-sm-block">
        <a href="#" class="text-dark"><i class="fas fa-home h2"></i></a>
      </div>
      <div class="account-pages my-5 pt-sm-5">
        <div class="">
          <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
              <div class="row">
                <div class="col-12">
                  <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">RFP</h4>
                    <div class="page-title-right">
                      <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item">
                          <a href="/vendors/rfp-quotes">RFP Quotes</a>
                        </li>
                        <li class="breadcrumb-item active">Add Quote</li>
                      </ol>
                    </div>
                  </div>
                </div>
              </div>
              <div class="card overflow-hidden">
                <div class="card-body pt-10">
                  <% if (success && success.length> 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                      <%= success %>
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                          <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <% } %>
                      <% if (error && error.length> 0) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                          <%= error %>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                              <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <% } %>
                          <div class="p-2">
                            <form class="validateform form-horizontal" action="/vendors/add/<%= rfpId %>" method="post">
                              <div class="row">
                                <!-- Item Name -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="vendor_price">Vendor Price <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="vendor_price" name="vendor_price"
                                      placeholder="Enter item name" value="<%= data?.vendor_price  || '' %>" data-rule-price="true">
                                  </div>
                                </div>
                                <!-- Item Description -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="description">Item Description <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="description" name="item_description"
                                      placeholder="Enter description" value="<%= data?.item_description || '' %>"
                                      data-rule-requiredMin2Max255="true">
                                  </div>
                                </div>
                                <!-- Quantity -->
                                <div class="col-md-12">
                                  <div class="form-group">
                                    <label for="quantity">Quantity <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="quantity" name="quantity"
                                      placeholder="Enter quantity" value="<%= data?.quantity || '' %>" min="1" data-rule-price="true">
                                  </div>
                                </div>
                                <!-- Last Date -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="totalcost">Total Cost<span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="totalcost" name="totalcost"
                                      placeholder="Enter Total Cost" value="<%= data?.totalcost || '' %>"
                                      data-rule-price="true" readonly>
                                  </div>
                                </div>

                                <!-- Submit -->
                                <div class="col-md-12 mt-3">
                                  <button class="btn btn-primary btn-block waves-effect waves-light" type="submit">
                                    Submit
                                  </button>
                                </div>

                              </div>
                            </form>

                          </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
</body>
<%- include('../partials/footer'); %>
<script>
  $(document).ready(function () {
    function calculateTotal() {
      let price = parseFloat($('#vendor_price').val()) || 0;
      let quantity = parseFloat($('#quantity').val()) || 0;
      let total = price * quantity;
      $('#totalcost').val(total.toFixed(2));
    }
    // Trigger on input change
    $('#vendor_price, #quantity').on('input', function () {
      calculateTotal();
    });
    // On page load
    calculateTotal();
  });
</script>

</html>