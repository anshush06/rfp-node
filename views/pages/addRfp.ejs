<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head'); %>
</head>

<body data-sidebar="dark">
  <!-- [ navigation menu ] start -->
  <%- include('../partials/header'); %>
    <!-- [ navigation menu ] end -->
    <%- include('../partials/sidebar'); %>
      <div class="home-btn d-none d-sm-block">
        <a href="#" class="text-dark"><i class="fas fa-home h2"></i></a>
      </div>
      <div class="account-pages my-5 pt-sm-5">
        <div class="">
          <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
              <div class="row">
                <div class="col-12">
                  <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">RFP</h4>
                    <div class="page-title-right">
                      <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item">
                          <a href="/rfps">RFP</a>
                        </li>
                        <li class="breadcrumb-item active">Add RFP</li>
                      </ol>
                    </div>
                  </div>
                </div>
              </div>
              <div class="card overflow-hidden">
                <div class="card-body pt-10">
                  <% if (success && success.length> 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                      <%= success %>
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                          <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <% } %>
                      <% if (error && error.length> 0) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                          <%= error %>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                              <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <% } %>
                          <div class="p-2">
                            <form class="validateform form-horizontal" action="/rfps/add" method="post">
                              <input type="hidden" class="form-control" id="category_id" name="category_id"
                                placeholder="Enter item name" value="<%= category_id || '' %>">
                              <div class="row">
                                <!-- Item Name -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="item_name">Item Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="item_name" name="item_name"
                                      placeholder="Enter item name" value="<%= rfp?.item_name || '' %>" data-rule-requiredMin2Max100="true">
                                  </div>
                                </div>
                                <!-- Item Description -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="description">Item Description <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="description" name="item_description"
                                      placeholder="Enter description" value="<%= rfp?.item_description || '' %>"
                                      data-rule-requiredMin2Max255="true">
                                  </div>
                                </div>
                                <!-- Quantity -->
                                <div class="col-md-12">
                                  <div class="form-group">
                                    <label for="quantity">Quantity <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="quantity" name="quantity"
                                      placeholder="Enter quantity" value="<%= rfp?.quantity || '' %>" min="1" data-rule-mandatory="true">
                                  </div>
                                </div>
                                <!-- Last Date -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="lastdate">Last Date <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="lastdate" name="lastdate"
                                      value="<%= rfp?.lastdate ? new Date(rfp.lastdate).toISOString().split('T')[0] : '' %>"
                                      min="<%= new Date().toISOString().split('T')[0] %>" data-rule-mandatory="true">
                                  </div>
                                </div>
                                <!-- Minimum Price -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="minprice">Minimum Price <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="minprice" name="minprice"
                                      placeholder="Enter minimum price" value="<%= rfp?.minprice || '' %>" min="0"
                                      step="0.01" data-rule-mandatory="true">
                                  </div>
                                </div>
                                <!-- Maximum Price -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="maxprice">Maximum Price <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="maxprice" name="maxprice"
                                      placeholder="Enter maximum price" value="<%= rfp?.maxprice || '' %>" min="0"
                                      step="0.01" data-rule-mandatory="true">
                                  </div>
                                </div>
                                <!-- Vendors -->
                                <div class="col-md-12 col-lg-6 col-xl-6">
                                  <div class="form-group">
                                    <label for="vendor_id">Vendors <span class="text-danger">*</span></label>
                                    <select class="form-control" id="vendor_id" name="vendors[]" multiple data-rule-mandatory="true">
                                      <option value="">Select Vendor</option>

                                      <% if (vendors && vendors.length> 0) { %>
                                        <% vendors.forEach(vendor=> { %>
                                          <option value="<%= vendor.id %>" <%=(rfp?.vendors &&
                                            Array.isArray(rfp.vendors) && rfp.vendors.map(v=>
                                            String(v)).includes(String(vendor.id))) ? 'selected' : '' %>>
                                            <%= vendor.firstname %>
                                              <%= vendor.lastname %>
                                          </option>
                                          <% }) %>
                                            <% } %>

                                    </select>
                                  </div>
                                </div>

                                <!-- Submit -->
                                <div class="col-md-12 mt-3">
                                  <button class="btn btn-primary btn-block waves-effect waves-light" type="submit">
                                    Submit
                                  </button>
                                </div>

                              </div>
                            </form>

                          </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
</body>
<%- include('../partials/footer'); %>

</html>