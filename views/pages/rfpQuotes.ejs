<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head'); %>
  </head>
  <body data-sidebar="dark">
    <!-- [ navigation menu ] start -->
    <%- include('../partials/header'); %>
    <!-- [ navigation menu ] end -->
    <%- include('../partials/sidebar'); %>
    <div class="main-content">
      <div class="page-content">
        <div class="container-fluid">
          <!-- start page title -->
          <div class="row">
            <div class="col-12">
              <div
                class="page-title-box d-flex align-items-center justify-content-between"
              >
                <h4 class="mb-0 font-size-18">RFP</h4>
                <div class="page-title-right">
                  <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                      <a href="javascript: void(0);">Home</a>
                    </li>
                    <li class="breadcrumb-item active">RFP Quotes</li>
                  </ol>
                </div>
              </div>
            </div>
        </div>
          <!-- end page title -->

          <!-- end row -->
           <% if (success && success.length> 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                </div>
                <% } %>
            <% if (error && error.length> 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                        <button type="button" class="close" data-dismiss="alert"
                            aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                </div>
            <% } %>
          <div class="row">
            <div class="col-lg-12">
              <div class="card">
                <div class="card-body">
                  <div class="TableHeader">
                    <div class="row">
                      <div class="col-lg-3">
                        <h4 class="card-title">RFP Quotes</h4>
                      </div>
                    </div>
                  </div>
                  <div class="table-responsive">
                    <table
                      class="table mb-0 listingData dt-responsive"
                      id="datatable"
                    >
                      <thead>
                        <tr>
                            <th>RFP No.</th>
                            <th>RFP Title</th>
                            <th>RFP Last Date</th>
                            <th>Min Amount</th>
                            <th>Max Amount</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (rfps && rfps.length > 0) { %>
                            <% rfps.forEach((rfp, index) => { %>
                                <tr>
                                    <td><%= rfp.rfp_number %></td>
                                    <td><%= rfp.name %></td>
                                    <td><%= new Date(rfp.lastdate).toISOString().slice(0, 10) %></td>
                                    <td><%= rfp.minprice %></td>
                                    <td><%= rfp.maxprice %></td>

                                    <td>
                                        <% if (rfp.status === 1) { %>
                                            <span class="badge badge-pill badge-success">Open</span>
                                        <% } else { %>
                                            <span class="badge badge-pill badge-danger">Closed</span>
                                        <% } %>
                                    </td>
                                    <td>
                                    <div class="d-flex align-items-center">

                                        <% if (rfp.status === 1) { %>

                                            <% if (rfp.hasApplied) { %>
                                                <!-- Applied Badge -->
                                                <span class="badge badge-pill badge-info mr-2">
                                                    Applied
                                                </span>

                                                <!-- Eye Icon -->
                                                <a
                                                    href="/rfps/view/<%= rfp.id %>"
                                                    class="text-primary"
                                                    title="View RFP Quotes"
                                                >
                                                    <i class="mdi mdi-eye" style="font-size: 20px;"></i>
                                                </a>

                                            <% } else { %>
                                                <!-- Apply Icon -->
                                                <a
                                                    href="/vendors/add/<%= rfp.id %>"
                                                    class="text-primary"
                                                    title="Apply Quote"
                                                >
                                                    <i class="mdi mdi-plus-circle" style="font-size: 20px;"></i>
                                                </a>
                                            <% } %>

                                        <% } else { %>
                                            <!-- Closed -->
                                            <span class="badge badge-pill badge-secondary">
                                                Closed
                                            </span>
                                        <% } %>

                                    </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center">No RFPs found</td>
                            </tr>
                        <% } %>
                    </tbody>
                    </table>
                  </div>
                <div class="row pt-3">
                    <div class="col-sm-12 col-md-5">
                        <%
                        const start = (currentPage - 1) * limit + 1;
                        const end = Math.min(currentPage * limit, totalRfps);
                        %>
                        <div
                        class="dataTables_info"
                        id="datatable_info"
                        role="status"
                        aria-live="polite"
                        >
                        Showing <%= start %> to <%= end %> of <%= totalRfps %> entries
                        </div>
                    </div>

                    <div class="col-sm-12 col-md-7 dataTables_wrapper">
                        <div class="dataTables_paginate paging_simple_numbers">
                        <ul class="pagination">
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
                            </li>

                            <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                            </li>
                            <% } %>

                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
                            </li>
                        </ul>
                        </div>
                    </div>
                    </div>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
  <%- include('../partials/footer'); %>
</html>
